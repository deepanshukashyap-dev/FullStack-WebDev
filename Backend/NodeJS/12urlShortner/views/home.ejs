<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URL Shortener</title>
  </head>
  <body>
    <h1>URL Shortener</h1>

    <form method="POST" action="/url">
      <input
        type="url"
        name="url"
        placeholder="Enter your long URL here"
        required
      />
      <br /><br />
      <button type="submit">Generate</button>
    </form>
    <div>

      <% if (locals.id) { %>
       <h3>Short URL: </h3><span>http://localhost:8001/url/<%= id %></span>
      <% } %>


      <h2>URL Analytics</h2>
      <% if (locals.urls) { %>
      <table>
        <thead>
          <tr>
            <th>S.No</th>
            <th>Short ID</th>
            <th>Redirect URL</th>
            <th>Clicks</th>
          </tr>
        </thead>

        <tbody>
          <% urls.forEach((u, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= u.shortId %></td>
            <td><%= u.redirectUrl %></td>
            <td><%= u.visitHistory.length %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
      
    </div>
  </body>
</html>
